{
  "extends": "../tsconfig.base.json",
  "include": ["*/angular/*.ts", "components/*/angular/*.ts"],
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": false,
    "rootDir": "..",
    "outDir": "node_modules/.angular",
    "paths": {
      "@ui-sdk/angular": ["../packages/angular/src/index.ts"],
      "@ui-sdk/angular/*": ["../packages/angular/src/*"]
    }
  },
  "angularCompilerOptions": { "strictTemplates": true }
}
